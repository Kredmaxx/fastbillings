  description String?
  cgst        Decimal  @default(0) @db.Decimal(18, 4)
  sgst        Decimal  @default(0) @db.Decimal(18, 4)
  igst        Decimal  @default(0) @db.Decimal(18, 4)
  cess        Decimal  @default(0) @db.Decimal(18, 4)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isDeleted, reversalDate])
  @@index([tenantId, isDeleted, reversalDate])
}

/// Imported Form 26AS / TDS credit rows for books reconcile (stub — not AIS/TIS).
model Form26AsImport {
