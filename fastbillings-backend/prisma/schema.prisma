// =============================================================================
// Models — Accounting (F.1: Chart of Accounts + Journal Entries)
// =============================================================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id            String                 @id @default(uuid())
  userId        String
  user          User                   @relation("UserAccounts", fields: [userId], references: [id])
  tenantId      String?
  tenant        Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code          String
  name          String
  accountType   AccountType
  parentId      String?
  parent        Account?               @relation("AccountParent", fields: [parentId], references: [id])
  children      Account[]              @relation("AccountParent")
  description   String?
  currencyCode  String?
  roleProtected Boolean                @default(false)
  isDeleted     Boolean                @default(false)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  journalLines  JournalLine[]
  roleMappings  LedgerAccountMapping[]
  budgets       Budget[]               @relation("AccountBudgets")

  @@unique([userId, code])
  @@index([userId, accountType])
  @@index([tenantId, accountType])
}

model JournalEntry {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation("UserJournalEntries", fields: [userId], references: [id])
  tenantId          String?
  tenant            Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryNumber       String?
  entryDate         DateTime
  postingDate       DateTime?
  description       String?
  reference         String?
  sourceType        String?
  sourceId          String?
  event             String?
  isSystemGenerated Boolean           @default(false)
  isOpeningBalance  Boolean           @default(false)
  reversedById      String?
  reversedBy        JournalEntry?     @relation("JournalReversal", fields: [reversedById], references: [id])
  reversals         JournalEntry[]    @relation("JournalReversal")
  periodId          String?
  period            AccountingPeriod? @relation("PeriodJournalEntries", fields: [periodId], references: [id])
  lines             JournalLine[]
  isPosted          Boolean           @default(true)
  isDeleted         Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([userId, sourceType, sourceId, event])
  @@index([userId, entryDate])
  @@index([tenantId, entryDate])
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(18, 4)
  credit         Decimal      @default(0) @db.Decimal(18, 4)
  currencyCode   String?
  exchangeRate   Decimal      @default(1) @db.Decimal(18, 8)
  baseDebit      Decimal      @default(0) @db.Decimal(18, 4)
  baseCredit     Decimal      @default(0) @db.Decimal(18, 4)
  taxRoleKey     String?
  description    String?
  costCenterId   String?
  costCenter     CostCenter?  @relation("CostCenterJournalLines", fields: [costCenterId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?     @relation("ProjectJournalLines", fields: [projectId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([costCenterId])
  @@index([projectId])
}

model LedgerAccountMapping {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserLedgerMappings", fields: [userId], references: [id])
  tenantId  String?
  tenant    Tenant?  @relation("TenantLedgerMappings", fields: [tenantId], references: [id], onDelete: Cascade)
  roleKey   String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleKey])
  @@index([userId])
  @@index([tenantId])
}

model AccountingPeriod {
  id                String         @id @default(uuid())
  userId            String
  user              User           @relation("UserAccountingPeriods", fields: [userId], references: [id])
  tenantId          String?
  tenant            Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name              String
  startDate         DateTime
  endDate           DateTime
  isLocked          Boolean        @default(false)
  lockedAt          DateTime?
  lockedBy          String?
  /// Year-end close completed (P&L closed to retained earnings).
  isClosed          Boolean        @default(false)
  closedAt          DateTime?
  closedBy          String?
  closingJournalId  String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  journalEntries    JournalEntry[] @relation("PeriodJournalEntries")

  @@index([userId, startDate])
  @@index([tenantId, startDate])
}

