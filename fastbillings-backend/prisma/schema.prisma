  auditLogs       AuditLog[]
  apiKeys         TenantApiKey[]
  brands          Brand[]
  categories      Category[]
  units           Unit[]
  products        Product[]
  inventories     Inventory[]
  warehouses      Warehouse[]
  stockTransfers  StockTransfer[]
  inventoryBatches InventoryBatch[]
  inventorySerials InventorySerial[]
  boms            Bom[]
  manufactureOrders ManufactureOrder[]
  taxRates        TaxRate[]
  tdsRates        TdsRate[]
  tcsRates        TcsRate[]
  itcReversals    ItcReversal[]
  form26AsImports Form26AsImport[]
  accounts        Account[]
  journalEntries  JournalEntry[]
  ledgerMappings    LedgerAccountMapping[] @relation("TenantLedgerMappings")
  accountingPeriods AccountingPeriod[]
  purchases       Purchase[]
  purchaseOrders  PurchaseOrder[]
  creditNotes     CreditNote[]
  salesDebitNotes SalesDebitNote[]
  debitNotes      DebitNote[]
  expenses        Expense[]
  expenseCategories ExpenseCategory[]
  pettyCashes     PettyCash[]
  advanceTaxPayments AdvanceTaxPayment[]
  advanceTaxSetoffs  AdvanceTaxSetoff[]
  selfAssessmentTaxPayments SelfAssessmentTaxPayment[]
  interest234Provisions Interest234Provision[]
  taxAuditOtherReceipts TaxAuditOtherReceipt[]
  salaryTdsEmployees SalaryTdsEmployee[]
  salaryTdsDeductions SalaryTdsDeduction[]
  taxDepositChallans TaxDepositChallan[]
  taxDepositChallanAllocations TaxDepositChallanAllocation[]
  tdsTcsReturnFilings TdsTcsReturnFiling[]
  bankDetails     BankDetail[]
  bankTransactions BankTransaction[]
  paymentModes    PaymentMode[]
  taxGroups       TaxGroup[]
  costCenters     CostCenter[]
  projects        Project[]
  budgets         Budget[]
