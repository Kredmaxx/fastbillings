// =============================================================================
// Models — Purchases & Expenses (D)
// =============================================================================

model Expense {
  id                String               @id @default(uuid())
  expenseId         String?              @unique // TODO 0.1c: app-generated EXP-NNNNNN
  referenceNo       String?              @default("")
  /// Gross amount paid (includes GST when taxAmount > 0).
  amount            Decimal              @db.Decimal(18, 4)
  /// GST portion of amount (ITC). Net expense = amount − taxAmount.
  taxAmount         Decimal              @default(0) @db.Decimal(18, 4)
  /// Optional CGST/SGST/IGST line taxes for split INPUT_* posting.
  taxes             Json?
  expenseDate       DateTime             @default(now())
  paymentModeId     String?
  paymentMode       PaymentMode?         @relation("ExpensePaymentMode", fields: [paymentModeId], references: [id])
  paymentStatus     ExpensePaymentStatus @default(PENDING)
  /// Optional payment date for §43B due-date review (books). Null = not tracked.
  paidDate          DateTime?
  description       String?              @default("")
  attachment        String?
  expenseCategoryId String
  expenseCategory   ExpenseCategory      @relation("ExpenseCategoryExpenses", fields: [expenseCategoryId], references: [id])
  sourceType        ExpenseSourceType
  bankId            String?
  bank              BankDetail?          @relation("ExpenseBank", fields: [bankId], references: [id])
  supplierId        String?
  supplier          Supplier?            @relation(fields: [supplierId], references: [id])
  isDeleted         Boolean              @default(false)
  userId            String
  user              User                 @relation("UserExpenses", fields: [userId], references: [id])
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  isRecurring          Boolean                       @default(false)
  parentExpense        String?
  parent               Expense?                      @relation("ExpenseRecurringParent", fields: [parentExpense], references: [id])
  children             Expense[]                     @relation("ExpenseRecurringParent")
  repeatEvery          RecurrenceFrequency?          @default(month)
  customIntervalNumber Int?
  customIntervalType   RecurrenceCustomIntervalType?
  startOn              DateTime?
  endsOn               DateTime?
  neverExpire          Boolean                       @default(false)
  stopped              Boolean                       @default(false)
  lastRecurringDate    DateTime?
  nextRecurringDate    DateTime?
  approvalStatus       ApprovalStatus                @default(NOT_REQUIRED)
  approvedById         String?
  approvedAt           DateTime?
  rejectionReason      String?

  costCenterId String?
  costCenter   CostCenter? @relation("CostCenterExpenses", fields: [costCenterId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?    @relation("ProjectExpenses", fields: [projectId], references: [id], onDelete: SetNull)

  currencyCode String? // per-expense currency (ISO code, e.g. 'USD'); null = company base currency
  exchangeRate Decimal? @db.Decimal(18, 8) // to functional/base currency; null = 1
  /// Optional Rule 6DD books exception code for §40A(3) cash screen (e.g. BANK_ACCOUNT). Not Form 3CD.
  rule6DdExceptionCode String?
  /// Optional books FMV for §40A(2) excess tag (related-party). Not Form 3CD / AO opinion.
  section40A2FairMarketValue Decimal? @db.Decimal(18, 4)
  section40A2FmvNote         String?
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  changeLogs ExpenseChangeLog[] @relation("ExpenseChangeLogs")

  @@index([tenantId])
  @@index([userId, isDeleted])
  @@index([rule6DdExceptionCode])
}

/// Income-tax audit books classification for expenses under this category (not Form 3CD).
enum ExpenseTaxClass {
  ALLOWABLE
  DISALLOWABLE
  CAPITAL
  PERSONAL
  UNCLASSIFIED
}

/// §43B statutory-dues nature tag for books worksheets (not Form 3CD / payroll).
enum Section43BNature {
  NONE
  BONUS
  PF_EMPLOYER
  ESI_EMPLOYER
  LEAVE_ENCASHMENT
  INTEREST_BANK
  TAX_DUTY_CESS
  OTHER_43B
}

model ExpenseCategory {
  id          String          @id @default(uuid())
  title       String
  description String?
  status      Boolean         @default(true)
  /// Tax-audit style class for P&L / disallowance worksheets (books only).
  taxClass    ExpenseTaxClass @default(UNCLASSIFIED)
  /// §43B nature for unpaid statutory-dues screen (books only — not Form 3CD).
  section43BNature Section43BNature @default(NONE)
  isDeleted   Boolean         @default(false)
  userId      String?
  user        User?           @relation("UserExpenseCategories", fields: [userId], references: [id])
  tenantId    String?
  tenant      Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  expenses Expense[] @relation("ExpenseCategoryExpenses")

  @@index([tenantId, isDeleted])
  @@index([userId, isDeleted])
  @@index([tenantId, taxClass])
  @@index([tenantId, section43BNature])
}

model ExpenseChangeLog {
  id            String   @id @default(uuid())
