// Cluster H — AI features
// =============================================================================

/// BYOK AI settings. One workspace config per tenant (tenantId unique when set).
model AiConfig {
  id               String         @id @default(uuid())
  userId           String         @unique
  user             User           @relation("UserAiConfig", fields: [userId], references: [id])
  tenantId         String?        @unique
  tenant           Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider         AiProviderKind @default(MOCK)
  enabled          Boolean        @default(false)
  encryptedApiKey  String?        @db.Text
  apiKeyHint       String?
  extractionModel  String?
  chatModel        String?
  monthlyBudgetUsd Decimal?       @default(0) @db.Decimal(10, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// Cluster H — slice H.2 (bill OCR → draft purchase)
model AiExtractionJob {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation("UserAiJobs", fields: [userId], references: [id])
  tenantId            String?
  tenant              Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceFilePath      String
  mimeType            String
  status              AiExtractionStatus @default(PENDING)
  extractedData       Json?
  rawResponse         String?            @db.Text
  errorMessage        String?
  confidence          Decimal?           @db.Decimal(4, 3)
  resultingPurchaseId String?            @unique
  resultingPurchase   Purchase?          @relation("PurchaseFromAi", fields: [resultingPurchaseId], references: [id])
  costUsd             Decimal?           @db.Decimal(10, 6)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([tenantId, status])
  @@index([userId, status])
}

// Cluster H — slice H.3 (financial co-pilot chat)
model AiChatSession {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation("UserAiChats", fields: [userId], references: [id])
  tenantId  String?
  tenant    Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String?
  messages  AiChatMessage[]
  isDeleted Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([tenantId, updatedAt])
  @@index([userId, updatedAt])
}

model AiChatMessage {
  id         String        @id @default(uuid())
  sessionId  String
  session    AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       AiChatRole
  content    String        @db.Text
  toolName   String?
  toolInput  Json?
  toolResult Json?
  costUsd    Decimal?      @db.Decimal(10, 6)
  createdAt  DateTime      @default(now())

  @@index([sessionId, createdAt])
}

// Cluster H — slice H.4 (per-call usage logging for cost charts + rate limits)
model AiUsageLog {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation("UserAiUsage", fields: [userId], references: [id])
  tenantId     String?
  tenant       Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature      String
  provider     AiProviderKind
  model        String?
  inputTokens  Int?
  outputTokens Int?
  costUsd      Decimal?       @db.Decimal(10, 6)
  createdAt    DateTime       @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

// =============================================================================
// Audit trail (Activity Log)
// =============================================================================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id            String      @id @default(uuid())
  action        AuditAction
  entityType    String
  entityId      String?
  entityLabel   String?
  summary       String
  changes       Json?
  affectedCount Int?
  tenantId      String?
  tenant        Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?       @relation("UserAuditLogs", fields: [userId], references: [id])
  userName      String
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
}

model TenantSubscription {
  id                     String             @id @default(uuid())
  tenantId               String
  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId                 String?
  plan                   Plan?              @relation(fields: [planId], references: [id], onDelete: SetNull)
  planCode               String
  status                 SubscriptionStatus @default(trialing)
  billingInterval        BillingInterval    @default(month)
  amountPaid             Decimal?           @db.Decimal(18, 4)
  currencyCode           String?            @default("USD")
  trialEndsAt            DateTime?
  currentPeriodStartsAt  DateTime?
  currentPeriodEndsAt    DateTime?
  cancelledAt            DateTime?
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  assignedBy             String?
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([tenantId, status])
  @@index([planId])
  @@index([provider, providerSubscriptionId])
}

model Plan {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  description     String?
  price           Decimal          @default(0) @db.Decimal(18, 4)
  currencyCode    String           @default("USD")
  billingCycle    PlanBillingCycle @default(monthly)
  trialDays       Int              @default(14)
  isFeatured      Boolean          @default(false)
  isActive        Boolean          @default(true)
  sortOrder       Int              @default(0)
  maxUsers        Int              @default(5)
  maxInvoices     Int              @default(100)
  maxCustomers    Int              @default(100)
  maxProducts     Int              @default(100)
  maxStorageMb    Int              @default(500)
  features        Json             @default("{}")
  stripePriceId   String?
  stripeProductId String?
  razorpayPlanId  String?
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  subscriptions TenantSubscription[]

  @@index([isActive, sortOrder])
  @@index([deletedAt])
}

// =============================================================================
// Platform — Marketing landing page CMS (singleton)
// =============================================================================

model LandingPage {
  id        String   @id @default("default")
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================================
// Multi-Currency — Spec G
// =============================================================================

model ExchangeRate {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation("UserExchangeRates", fields: [userId], references: [id])
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromCurrency String
  toCurrency   String
  rate         Decimal  @db.Decimal(18, 8)
  asOfDate     DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, fromCurrency, toCurrency, asOfDate])
  @@index([tenantId, fromCurrency, toCurrency, asOfDate])
}

// =============================================================================
// P3.3 — Cost Centers / Job Costing
// =============================================================================

model CostCenter {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserCostCenters", fields: [userId], references: [id])
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalLines JournalLine[] @relation("CostCenterJournalLines")
  invoices     Invoice[]     @relation("CostCenterInvoices")
  expenses     Expense[]     @relation("CostCenterExpenses")
  purchases    Purchase[]    @relation("CostCenterPurchases")

  @@unique([userId, code])
  @@index([userId])
  @@index([tenantId])
}

model Project {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserProjects", fields: [userId], references: [id])
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalLines JournalLine[] @relation("ProjectJournalLines")
  invoices     Invoice[]     @relation("ProjectInvoices")
  expenses     Expense[]     @relation("ProjectExpenses")
  purchases    Purchase[]    @relation("ProjectPurchases")

  @@unique([userId, code])
  @@index([userId])
  @@index([tenantId])
}

// =============================================================================
// P3.2 — Budgeting
// =============================================================================

model Budget {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserBudgets", fields: [userId], references: [id])
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account  @relation("AccountBudgets", fields: [accountId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  amount      Decimal  @db.Decimal(18, 4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, accountId, periodStart])
  @@index([tenantId, accountId, periodStart])
}

// =============================================================================
// P3.4 — Fixed Assets + Depreciation
// =============================================================================

model FixedAsset {
  id                      String    @id @default(uuid())
  userId                  String
  user                    User      @relation("UserFixedAssets", fields: [userId], references: [id])
  tenantId                String?
  tenant                  Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                    String
  cost                    Decimal   @db.Decimal(18, 4)
  salvageValue            Decimal   @default(0) @db.Decimal(18, 4)
  usefulLifeMonths        Int
  method                  String    @default("STRAIGHT_LINE")
  acquisitionDate         DateTime
  accumulatedDepreciation Decimal   @default(0) @db.Decimal(18, 4)
  lastDepreciatedOn       DateTime?
  status                  String    @default("active") // active | disposed | fully_depreciated
  /// Income-tax block label (e.g. Computers, Plant & Machinery) — books WDV worksheet.
  itBlock                 String?
  /// IT Act block depreciation rate % (e.g. 15, 40).
  itRatePercent           Decimal?  @db.Decimal(8, 4)
  /// Opening WDV for IT schedule; null = treat cost as opening/addition basis.
  itOpeningWdv            Decimal?  @db.Decimal(18, 4)
  isDeleted               Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([userId, status])
  @@index([tenantId, status, isDeleted])
}

// =============================================================================
// P3.5 — Inventory FIFO Cost Layers
// =============================================================================

model InventoryCostLayer {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation("UserInventoryCostLayers", fields: [userId], references: [id])
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String
  qtyRemaining Decimal  @db.Decimal(18, 4)
  unitCost     Decimal  @db.Decimal(18, 4)
  receivedAt   DateTime
  sourceType   String?
  sourceId     String?
  isDeleted    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, productId, receivedAt])
  @@index([tenantId, productId, receivedAt])
}
