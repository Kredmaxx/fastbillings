// Models — Core entities (B)
// =============================================================================

model BankDetail {
  id                String          @id @default(uuid())
  accountHoldername String
  bankName          String
  branchName        String
  accountNumber     String
  // BC.2: regional bank-code format stored in IFSCCode (IFSC, SORT_CODE, ROUTING,
  // IBAN, SWIFT, BSB, OTHER); null = legacy (treat as IFSC)
  bankCodeType      String?
  IFSCCode          String
  accountType       BankAccountType
  openingBalance    Decimal?        @default(0) @db.Decimal(18, 4)
  currentBalance    Decimal?        @default(0) @db.Decimal(18, 4)
  asOnDate          DateTime?       @default(now())
  // BC.1: per-account currency (ISO code, e.g. 'USD'); null = company base currency
  currencyCode      String?
  isDeleted         Boolean         @default(false)
  status            Boolean         @default(true)
  userId            String
  user              User            @relation("UserBankDetails", fields: [userId], references: [id])
  tenantId          String?
  tenant            Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  bankTransactions       BankTransaction[] @relation("BankDetailTransactions")
  supplierPayments       SupplierPayment[] @relation("BankDetailSupplierPayments")
  expenses               Expense[]         @relation("ExpenseBank")
  purchases              Purchase[]        @relation("PurchaseBank")
  purchaseOrders         PurchaseOrder[]   @relation("PurchaseOrderBank")
  creditNotesAsBank      CreditNote[]      @relation("CreditNoteBank")
  debitNotesAsBank       DebitNote[]       @relation("DebitNoteBank")
  deliveryChallansAsBank DeliveryChallan[] @relation("DeliveryChallanBank")
  invoicesAsBank         Invoice[]         @relation("InvoiceBank")
  invoicePayments        InvoicePayment[]  @relation("InvoicePaymentBank")
  quotationsAsBank       Quotation[]       @relation("QuotationBank")

  @@unique([userId, accountNumber])
  @@index([userId])
  @@index([tenantId, isDeleted])
  @@index([isDeleted])
  @@index([status])
}

model BankTransaction {
  id                 String                      @id @default(uuid())
  bankAccountId      String
  bankAccount        BankDetail                  @relation("BankDetailTransactions", fields: [bankAccountId], references: [id])
  tenantId           String?
  tenant             Tenant?                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactionDate    DateTime                    @default(now())
  type               BankTransactionType
  amount             Decimal                     @db.Decimal(18, 4)
  balanceBefore      Decimal                     @db.Decimal(18, 4)
  balanceAfter       Decimal                     @db.Decimal(18, 4)
  paymentModeId      String
  paymentMode        PaymentMode                 @relation("PaymentModeBankTransactions", fields: [paymentModeId], references: [id])
  referenceNo        String?
  remarks            String?
  relatedType        BankTransactionRelatedType? @default(MANUAL)
  relatedId          String?
  isReconciled       Boolean                     @default(false)
  reconciledBy       String?
  reconciledByUser   User?                       @relation("UserReconciledBankTransactions", fields: [reconciledBy], references: [id])
  reconciliationDate DateTime?
  reconciliationNote String?
  isDeleted          Boolean                     @default(false)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([bankAccountId])
  @@index([tenantId, isDeleted])
  @@index([transactionDate])
  @@index([relatedType, relatedId])
  @@index([isDeleted])
}

model Brand {
  id          String   @id @default(uuid())
  brand_name  String
  brand_image String?
  status      Boolean  @default(true)
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[] @relation("BrandProducts")

  @@unique([tenantId, brand_name])
  @@index([tenantId])
}

/// Income-tax audit books classification for sales under this product category (not Form 3CD).
enum IncomeTaxClass {
  BUSINESS
  EXEMPT
  CAPITAL
  OTHER
  UNCLASSIFIED
}

model Category {
  id             String         @id @default(uuid())
  category_name  String
  slug           String
  category_image String?
  status         Boolean        @default(true)
  /// Tax-audit style class for income / receipts worksheets (books only).
  taxClass       IncomeTaxClass @default(UNCLASSIFIED)
  tenantId       String?
  tenant         Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  products Product[] @relation("CategoryProducts")

  @@unique([tenantId, category_name])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, taxClass])
}

model Customer {
  id              String         @id @default(uuid())
  name            String
  email           String
  phone           String?
  whatsapp        String?        @default("")
  externalSource  String?
  externalRef     String?
  website         String?        @default("")
  image           String?        @default("")
  notes           String?        @default("")
  status          CustomerStatus @default(Active)
  billingAddress  Json?
  shippingAddress Json?
  bankDetails     Json?
  gstin           String?
  /// Income-tax PAN (Form 27EQ collectee / 26AS matching).
  pan             String?
  // CC.1: customer's default transaction currency (null = legacy/company-default currency)
  currencyCode    String?
  userId          String
  user            User           @relation("UserCustomers", fields: [userId], references: [id])
  tenantId        String?
  tenant          Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isDeleted       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  invoicesAsCustomer         Invoice[]         @relation("InvoiceCustomer")
  invoicesAsBillTo           Invoice[]         @relation("InvoiceBillTo")
  quotationsAsCustomer       Quotation[]       @relation("QuotationCustomer")
  quotationsAsBillTo         Quotation[]       @relation("QuotationBillTo")
  saleOrdersAsCustomer       SaleOrder[]       @relation("SaleOrderCustomer")
  saleOrdersAsBillTo         SaleOrder[]       @relation("SaleOrderBillTo")
  creditNotesAsCustomer      CreditNote[]      @relation("CreditNoteCustomer")
  creditNotesAsBillTo        CreditNote[]      @relation("CreditNoteBillTo")
  salesDebitNotesAsCustomer   SalesDebitNote[]  @relation("SalesDebitNoteCustomer")
  salesDebitNotesAsBillTo     SalesDebitNote[]  @relation("SalesDebitNoteBillTo")
  deliveryChallansAsCustomer DeliveryChallan[] @relation("DeliveryChallanCustomer")
  deliveryChallansAsBillTo   DeliveryChallan[] @relation("DeliveryChallanBillTo")
  reminders                  Reminder[]        @relation("ReminderCustomer")
  vehicles                   Vehicle[]
  productRates               CustomerProductRate[]

  @@unique([externalSource, externalRef, tenantId], name: "customer_external_tenant_upsert_idx")
  @@unique([tenantId, email], name: "customer_tenant_email_unique")
  @@index([tenantId])
  @@index([userId])
}

model CustomerProductRate {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sellingPrice Decimal  @db.Decimal(18, 4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([tenantId])
  @@index([productId])
}

model Warehouse {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserWarehouses", fields: [userId], references: [id])
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  code      String?
  isDefault Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories          Inventory[]
  transfersFrom        StockTransfer[] @relation("StockTransferFrom")
  transfersTo          StockTransfer[] @relation("StockTransferTo")
  invoices             Invoice[]       @relation("InvoiceWarehouse")
  saleOrders           SaleOrder[]     @relation("SaleOrderWarehouse")
  purchases            Purchase[]      @relation("PurchaseWarehouse")
  inventoryBatches     InventoryBatch[]  @relation("WarehouseInventoryBatches")
  inventorySerials     InventorySerial[] @relation("WarehouseInventorySerials")
  manufactureOrders    ManufactureOrder[] @relation("WarehouseManufactureOrders")

  @@index([tenantId, isDeleted])
  @@index([userId, isDeleted])
}

model Inventory {
  id                String     @id @default(uuid())
  productId         String
  product           Product    @relation("ProductInventories", fields: [productId], references: [id])
  warehouseId       String?
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  quantity          Int        @default(0) // legacy integer stock; use quantityOnHand for ledger-aware (WAC) stock
  avgCost           Decimal    @default(0) @db.Decimal(18, 4)
  quantityOnHand    Decimal    @default(0) @db.Decimal(18, 4)
  userId            String
  user              User       @relation("UserInventories", fields: [userId], references: [id])
  tenantId          String?
  tenant            Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isDeleted         Boolean    @default(false)
  inventory_history Json?
  notes             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([userId, isDeleted])
  @@index([tenantId, isDeleted])
  @@index([productId])
  @@index([warehouseId])
  @@unique([userId, productId, warehouseId])
}

model StockTransfer {
  id              String              @id @default(uuid())
  transferNumber  String?
  userId          String
  user            User                @relation("UserStockTransfers", fields: [userId], references: [id])
  tenantId        String?
  tenant          Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromWarehouseId String
  fromWarehouse   Warehouse           @relation("StockTransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse           @relation("StockTransferTo", fields: [toWarehouseId], references: [id])
  transferDate    DateTime            @default(now())
  notes           String?
  status          String              @default("COMPLETED")
  isDeleted       Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  lines           StockTransferLine[]

  @@index([tenantId, transferDate])
  @@index([userId, isDeleted])
}

model StockTransferLine {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation("ProductStockTransferLines", fields: [productId], references: [id])
  quantity   Decimal       @db.Decimal(18, 4)
  unitCost   Decimal       @default(0) @db.Decimal(18, 4)

  @@index([transferId])
  @@index([productId])
}

enum ManufactureOrderStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

/// Bill of materials for a finished good (Phase 14).
model Bom {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation("UserBoms", fields: [userId], references: [id])
  tenantId          String?
  tenant            Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  finishedProductId String
  finishedProduct   Product  @relation("BomFinishedProduct", fields: [finishedProductId], references: [id])
  name              String?
  isActive          Boolean  @default(true)
  isDeleted         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lines             BomLine[]
  orders            ManufactureOrder[]

  @@unique([userId, finishedProductId])
  @@index([tenantId, isDeleted])
  @@index([userId, isDeleted])
}

model BomLine {
  id                 String  @id @default(uuid())
  bomId              String
  bom                Bom     @relation(fields: [bomId], references: [id], onDelete: Cascade)
  componentProductId String
  componentProduct   Product @relation("BomComponentProduct", fields: [componentProductId], references: [id])
  qtyPerBuild        Decimal @db.Decimal(18, 4)
  sortOrder          Int     @default(0)

  @@unique([bomId, componentProductId])
  @@index([bomId])
}

model ManufactureOrder {
  id            String                  @id @default(uuid())
  userId        String
  user          User                    @relation("UserManufactureOrders", fields: [userId], references: [id])
  tenantId      String?
  tenant        Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bomId         String
  bom           Bom                     @relation(fields: [bomId], references: [id])
  orderNumber   String?
  warehouseId   String
  warehouse     Warehouse               @relation("WarehouseManufactureOrders", fields: [warehouseId], references: [id])
  quantity      Decimal                 @db.Decimal(18, 4)
  status        ManufactureOrderStatus  @default(DRAFT)
  notes         String?
  completedAt   DateTime?
  totalBuildCost Decimal?               @db.Decimal(18, 4)
  isDeleted     Boolean                 @default(false)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  lines         ManufactureOrderLine[]

  @@index([tenantId, status])
  @@index([userId, isDeleted])
}

model ManufactureOrderLine {
  id        String           @id @default(uuid())
  orderId   String
  order     ManufactureOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product          @relation("ProductManufactureOrderLines", fields: [productId], references: [id])
  /// COMPONENT | FINISHED
  role      String
  quantity  Decimal          @db.Decimal(18, 4)
  unitCost  Decimal          @default(0) @db.Decimal(18, 4)

  @@index([orderId])
  @@index([productId])
}

model Product {
  id               String          @id @default(uuid())
  item_type        ProductItemType
  name             String
  code             String
  categoryId       String
  category         Category        @relation("CategoryProducts", fields: [categoryId], references: [id])
  brandId          String
  brand            Brand           @relation("BrandProducts", fields: [brandId], references: [id])
  unitId           String
  unit             Unit            @relation("UnitProducts", fields: [unitId], references: [id])
  /// Optional billing unit. Stock always stays in `unitId` (primary).
  secondaryUnitId  String?
  secondaryUnit    Unit?           @relation("UnitSecondaryProducts", fields: [secondaryUnitId], references: [id], onDelete: SetNull)
  /// How many primary units equal 1 secondary unit (e.g. 12 PCS per BOX).
  secondaryToPrimaryQty Decimal?   @db.Decimal(18, 6)
  /// Which unit selling_price is expressed in, and the default on invoices/POS. PRIMARY | SECONDARY
  billingUnit      String          @default("PRIMARY")
  selling_price    Decimal         @db.Decimal(18, 4)
  purchase_price   Decimal         @db.Decimal(18, 4)
  discount_type    String
  discount_value   Decimal         @db.Decimal(18, 4)
  taxGroupId       String
  taxGroup         TaxGroup        @relation("TaxGroupProducts", fields: [taxGroupId], references: [id])
  barcode          String
  alert_quantity   Int
  description      String
  product_image    String
  gallery_images   Json?
  enable_inventory Boolean         @default(false)
  stock            Int             @default(0)
  status           Boolean         @default(true)
  // P3.5: FIFO vs WAC valuation method. Default WAC → existing path unchanged.
  valuationMethod  String          @default("WAC")
  /// NONE | BATCH | SERIAL — identity tracking beside WAC/FIFO cost.
  trackingMode     String          @default("NONE")
  // PC.1: currency the product is priced in (null = legacy/company-default currency)
  currencyCode     String?
  /// India GST: HSN (goods) or SAC (services) code
  hsnSac           String?
  /// TAXABLE (default) | NIL_RATED | EXEMPT | NON_GST
  gstSupplyType    GstSupplyType   @default(TAXABLE)
  tenantId         String?
  tenant           Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  inventories        Inventory[]         @relation("ProductInventories")
  stockTransferLines StockTransferLine[] @relation("ProductStockTransferLines")
  inventoryBatches   InventoryBatch[]    @relation("ProductInventoryBatches")
  inventorySerials   InventorySerial[]   @relation("ProductInventorySerials")
  bomsAsFinished     Bom[]               @relation("BomFinishedProduct")
  bomComponentLines  BomLine[]           @relation("BomComponentProduct")
  manufactureOrderLines ManufactureOrderLine[] @relation("ProductManufactureOrderLines")
  customerRates      CustomerProductRate[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([tenantId, hsnSac])
  @@index([secondaryUnitId])
}

/// Warehouse-scoped lot / batch quantity (Phase 12).
model InventoryBatch {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("UserInventoryBatches", fields: [userId], references: [id])
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation("ProductInventoryBatches", fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation("WarehouseInventoryBatches", fields: [warehouseId], references: [id])
  lotNumber   String
  expiryDate  DateTime?
  qtyOnHand   Decimal   @default(0) @db.Decimal(18, 4)
  unitCost    Decimal?  @db.Decimal(18, 4)
  sourceType  String?
  sourceId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  serials InventorySerial[] @relation("BatchSerials")

  @@unique([userId, productId, warehouseId, lotNumber])
  @@index([tenantId])
  @@index([productId, warehouseId])
  @@index([expiryDate])
}

/// Per-unit serial numbers (Phase 12).
model InventorySerial {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation("UserInventorySerials", fields: [userId], references: [id])
  tenantId     String?
  tenant       Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId    String
  product      Product         @relation("ProductInventorySerials", fields: [productId], references: [id])
  warehouseId  String?
  warehouse    Warehouse?      @relation("WarehouseInventorySerials", fields: [warehouseId], references: [id], onDelete: SetNull)
  batchId      String?
  batch        InventoryBatch? @relation("BatchSerials", fields: [batchId], references: [id], onDelete: SetNull)
  serialNumber String
  /// AVAILABLE | SOLD | RETURNED | TRANSFERRED
  status       String          @default("AVAILABLE")
  unitCost     Decimal?        @db.Decimal(18, 4)
  sourceType   String?
  sourceId     String?
  soldAt       DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([userId, productId, serialNumber])
  @@index([tenantId])
  @@index([productId, status])
  @@index([warehouseId, status])
}

model Signature {
  id             String   @id @default(uuid())
  signatureName  String
  signatureImage String
  status         Boolean  @default(true)
  markAsDefault  Boolean  @default(false)
  isDeleted      Boolean  @default(false)
  userId         String
  user           User     @relation("UserSignatures", fields: [userId], references: [id])
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices         Invoice[]         @relation("InvoiceSignature")
  quotations       Quotation[]       @relation("QuotationSignature")
  purchases        Purchase[]        @relation("PurchaseSignature")
  purchaseOrders   PurchaseOrder[]   @relation("PurchaseOrderSignature")
  creditNotes      CreditNote[]      @relation("CreditNoteSignature")
  debitNotes       DebitNote[]       @relation("DebitNoteSignature")
  deliveryChallans DeliveryChallan[] @relation("DeliveryChallanSignature")

  @@index([tenantId])
  @@index([userId, isDeleted])
}

model Supplier {
  id             String               @id @default(uuid())
  user_id        String
  user           User                 @relation("UserSuppliers", fields: [user_id], references: [id])
  tenantId       String?
  tenant         Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier_name  String
  supplier_email String               @unique
  supplier_phone String
  gstin          String?
  /// Income-tax PAN (Form 26Q deductee).
  pan            String?
  /// Micro/Small/Medium enterprise (MSME / Udyam) — 45-day payment tracking
  isMsme         Boolean              @default(false)
  msmeUdyam      String?
  /// Non-resident deductee — TDS goes to Form 27Q (not Form 26Q)
  isNonResident  Boolean              @default(false)
  /// Related party / specified person u/s 40A(2)(b) — books disclosure tag (not Form 3CD).
  isRelatedParty Boolean              @default(false)
  balance        Decimal?             @default(0) @db.Decimal(18, 4)
  balance_type   SupplierBalanceType?
  // SC.1: supplier's currency (null = legacy/company-default currency)
  currencyCode   String?
  status         Boolean              @default(true)
  isDeleted      Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  expenses Expense[]

  @@index([tenantId])
  @@index([user_id, isDeleted])
}

model SupplierPayment {
  id              String                    @id @default(uuid())
  paymentId       String?                   @unique // TODO 0.1c: app-generated PAY-NNNNNN sequence
  purchaseId      String
  purchase        Purchase                  @relation("PurchaseSupplierPayments", fields: [purchaseId], references: [id])
  supplierId      String
  supplier        User                      @relation("UserSupplierPaymentsAsSupplier", fields: [supplierId], references: [id])
  tenantId        String?
  tenant          Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referenceNumber String?
  paymentDate     DateTime                  @default(now())
  paymentModeId   String?
  paymentMode     PaymentMode?              @relation("PaymentModeSupplierPayments", fields: [paymentModeId], references: [id])
  sourceType      SupplierPaymentSourceType
  bankId          String?
  bank            BankDetail?               @relation("BankDetailSupplierPayments", fields: [bankId], references: [id])
  amount          Decimal                   @db.Decimal(18, 4)
  paidAmount      Decimal                   @db.Decimal(18, 4)
  dueAmount       Decimal                   @db.Decimal(18, 4)
  notes           String?
  attachment      String?
  isDeleted       Boolean                   @default(false)
  createdBy       String?
  createdByUser   User?                     @relation("UserSupplierPaymentsCreated", fields: [createdBy], references: [id])
  currencyCode    String?
  exchangeRate    Decimal?                  @db.Decimal(18, 8)
  /// Optional Rule 6DD books exception code for §40A(3) cash screen. Not Form 3CD.
  rule6DdExceptionCode String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([tenantId, isDeleted])
  @@index([createdBy, isDeleted])
  @@index([purchaseId])
  @@index([rule6DdExceptionCode])
}

// =============================================================================
// Models — Invoicing (C)
// =============================================================================

model Counter {
  id    String  @id @default(uuid())
  key   String? @unique
  value Int     @default(0)
}

model CreditNote {
  id                  String                 @id @default(uuid())
  creditNoteNumber    String?                @unique // TODO 0.1c: app-generated CN-NNNNNN
  invoiceId           String
  invoice             Invoice                @relation("CreditNoteInvoice", fields: [invoiceId], references: [id])
  customerId          String
  customer            Customer               @relation("CreditNoteCustomer", fields: [customerId], references: [id])
  creditNoteDate      DateTime               @default(now())
  referenceNo         String?                @default("")
  reason              CreditNoteReason?      @default(OTHER)
  description         String?                @default("")
  items               Json?
  status              CreditNoteStatus       @default(PENDING)
  refund_method       CreditNoteRefundMethod @default(CREDIT_TO_ACCOUNT)
  taxableAmount       Decimal                @db.Decimal(18, 4)
  totalAmount         Decimal                @db.Decimal(18, 4)
  vat                 Decimal?               @default(0) @db.Decimal(18, 4)
  totalDiscount       Decimal?               @default(0) @db.Decimal(18, 4)
  roundOff            Boolean                @default(false)
  bankId              String?
  bank                BankDetail?            @relation("CreditNoteBank", fields: [bankId], references: [id])
  notes               String?
  termsAndCondition   String?
  sign_type           SignType               @default(none)
  signatureName       String?
  signatureId         String?
  signature           Signature?             @relation("CreditNoteSignature", fields: [signatureId], references: [id])
  signatureImage      String?
  currencyCode        String? // C.1: per-document currency (ISO code, e.g. 'USD')
  isDeleted           Boolean                @default(false)
  userId              String
  user                User                   @relation("CreditNoteUser", fields: [userId], references: [id])
  billFrom            String
  billFromUser        User                   @relation("CreditNoteBillFrom", fields: [billFrom], references: [id])
  billTo              String
  billToCustomer      Customer               @relation("CreditNoteBillTo", fields: [billTo], references: [id])
  appliedToInvoice    String?
  appliedToInvoiceRel Invoice?               @relation("CreditNoteAppliedToInvoice", fields: [appliedToInvoice], references: [id])
  appliedDate         DateTime?
  tenantId            String?
  tenant              Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([tenantId])
  @@index([userId, isDeleted])
}

/// Outward (sales) debit note — increases receivable / outward tax vs original invoice.
/// Distinct from purchase DebitNote (vendor / inward). Feeds GSTR-1 CDNR noteType 'D'.
model SalesDebitNote {
  id                 String            @id @default(uuid())
  debitNoteNumber    String?           @unique
  invoiceId          String
  invoice            Invoice           @relation("SalesDebitNoteInvoice", fields: [invoiceId], references: [id])
  customerId         String
  customer           Customer          @relation("SalesDebitNoteCustomer", fields: [customerId], references: [id])
  debitNoteDate      DateTime          @default(now())
  referenceNo        String?           @default("")
  reason             CreditNoteReason? @default(OTHER)
  description        String?           @default("")
  items              Json?
  status             CreditNoteStatus  @default(PENDING)
  taxableAmount      Decimal           @db.Decimal(18, 4)
  totalAmount        Decimal           @db.Decimal(18, 4)
  vat                Decimal?          @default(0) @db.Decimal(18, 4)
