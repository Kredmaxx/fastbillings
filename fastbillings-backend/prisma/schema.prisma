enum Gstr2bMatchStatus {
  UNMATCHED
  MATCHED
  PARTIAL
  MISSING_IN_BOOKS
}

model Gstr2bImport {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation("UserGstr2bImports", fields: [userId], references: [id])
  tenantId     String?
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodMonth  String
  sourceLabel  String?
  importedAt   DateTime      @default(now())
  lineCount    Int           @default(0)
  matchedCount Int           @default(0)
  partialCount Int           @default(0)
  missingCount Int           @default(0)
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lines        Gstr2bLine[]

  @@index([userId, periodMonth])
  @@index([tenantId, periodMonth])
}

model Gstr2bLine {
  id              String            @id @default(uuid())
  importId        String
  import          Gstr2bImport      @relation(fields: [importId], references: [id], onDelete: Cascade)
  /// B2B | CDNR | CDNUR | OTHER
  docType         String            @default("B2B")
  supplierGstin   String?
  supplierName    String?
  invoiceNumber   String
  invoiceDate     DateTime?
  taxableValue    Decimal           @db.Decimal(18, 4)
  igst            Decimal           @default(0) @db.Decimal(18, 4)
  cgst            Decimal           @default(0) @db.Decimal(18, 4)
  sgst            Decimal           @default(0) @db.Decimal(18, 4)
  cess            Decimal           @default(0) @db.Decimal(18, 4)
  invoiceValue    Decimal?          @db.Decimal(18, 4)
  /// Accountant override: include in eligible ITC totals
  itcEligible     Boolean           @default(true)
  matchStatus     Gstr2bMatchStatus @default(UNMATCHED)
  matchedPurchaseId String?
  matchedDebitNoteId String?
  matchNotes      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([importId, matchStatus])
  @@index([invoiceNumber])
  @@index([docType])
}

/// Xero / QuickBooks OAuth connection. One workspace row per tenant+kind;
/// legacy rows stay unique on userId+kind. (Provider org id lives in config JSON.)
model AccountingIntegration {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation("UserAccountingIntegrations", fields: [userId], references: [id])
  tenantId     String?
  tenant       Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind         IntegrationKind
  enabled      Boolean         @default(false)
  config       Json
  lastSyncedAt DateTime?
  syncStatus   String?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([userId, kind])
  @@unique([tenantId, kind], name: "accounting_integration_tenant_kind_unique")
  @@index([tenantId])
}

/// WhatsApp / messaging BYOK settings. One workspace config per tenant.
model MessagingConfig {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation("UserMessagingConfig", fields: [userId], references: [id])
  tenantId         String?  @unique
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsappEnabled  Boolean  @default(false)
  whatsappProvider String?
  whatsappConfig   Json?
  defaultTemplate  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// E-invoice / e-way bill provider credentials (ClearTax, Masters India, or mock).
/// One workspace config per tenant (tenantId unique when set); legacy rows stay user-unique.
model GstComplianceConfig {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation("UserGstComplianceConfig", fields: [userId], references: [id])
  tenantId         String?  @unique
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// mock | cleartax | masters_india
  eInvoiceProvider String   @default("mock")
  /// mock | cleartax | masters_india
  eWayProvider     String   @default("mock")
  enabled          Boolean  @default(true)
  livemode         Boolean  @default(false)
  /// Vendor credentials: baseUrl, apiKey, apiSecret, username, password, gstin, …
  config           Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

