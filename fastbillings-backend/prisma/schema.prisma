model AdvanceTaxSetoff {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation("UserAdvanceTaxSetoffs", fields: [userId], references: [id])
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// e.g. 2025-26
  fyLabel         String
  setoffDate      DateTime
  /// Estimated / provisioned income-tax liability for the FY (books).
  provisionAmount Decimal  @db.Decimal(18, 4)
  /// Advance tax applied: Dr TAX_PAYABLE / Cr ADVANCE_TAX.
  setoffAmount    Decimal  @db.Decimal(18, 4)
  notes           String?
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, isDeleted, fyLabel])
  @@index([tenantId, isDeleted, fyLabel])
}

/// Self-assessment tax paid against remaining income-tax payable (books — not OLTAS / ITR).
model SelfAssessmentTaxPayment {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation("UserSelfAssessmentTaxPayments", fields: [userId], references: [id])
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// e.g. 2025-26
  fyLabel   String
  paidDate  DateTime?
  amount    Decimal   @db.Decimal(18, 4)
  challanNo String?
  notes     String?
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, isDeleted, fyLabel])
  @@index([tenantId, isDeleted, fyLabel])
}

/// Books provision for interest u/s 234B/C (estimate → GL). Not CPC / ITR / OLTAS.
model Interest234Provision {
  id                          String    @id @default(uuid())
  userId                      String
  user                        User      @relation("UserInterest234Provisions", fields: [userId], references: [id])
  tenantId                    String?
  tenant                      Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// e.g. 2025-26
  fyLabel                     String
  provisionDate               DateTime
  amount234B                  Decimal   @db.Decimal(18, 4)
  amount234C                  Decimal   @db.Decimal(18, 4)
  totalAmount                 Decimal   @db.Decimal(18, 4)
  estimatedLiabilitySnapshot  Decimal?  @db.Decimal(18, 4)
  advanceTaxPaidSnapshot      Decimal?  @db.Decimal(18, 4)
  asOfDate                    DateTime?
  notes                       String?
  isDeleted                   Boolean   @default(false)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@index([userId, isDeleted, fyLabel])
  @@index([tenantId, isDeleted, fyLabel])
}

/// Manual non-invoice receipts for tax-audit income books worksheet (not Form 3CD).
model TaxAuditOtherReceipt {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation("UserTaxAuditOtherReceipts", fields: [userId], references: [id])
  tenantId    String?
  tenant      Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  receiptDate DateTime
  description String
  amount      Decimal        @db.Decimal(18, 4)
  taxClass    IncomeTaxClass @default(OTHER)
  notes       String?
  isDeleted   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, isDeleted, receiptDate])
  @@index([tenantId, isDeleted, receiptDate])
}

/// TDS/TCS deposit challans (OLTAS-style books tracker — not IT portal / TRACES).
model TaxDepositChallan {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserTaxDepositChallans", fields: [userId], references: [id])
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// TDS | TCS
  kind        String
  /// e.g. 2025-26
  fyLabel     String
  /// Q1 | Q2 | Q3 | Q4
  quarter     String
  /// Optional section e.g. 194C / 206C(1H)
  section     String?
  bsrCode     String
  challanNo   String
  depositDate DateTime
  amount      Decimal  @db.Decimal(18, 4)
  notes       String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  allocations TaxDepositChallanAllocation[]

  @@index([userId, isDeleted, kind, fyLabel, quarter])
  @@index([tenantId, isDeleted, kind, fyLabel, quarter])
}

/// Books flag that a TDS/TCS statement (24Q/26Q/27Q/27EQ) was filed for FY+quarter.
/// Not TRACES / CPC / e-TDS filing proof — Form 3CD–style cl. 34(b) worksheet only.
model TdsTcsReturnFiling {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation("UserTdsTcsReturnFilings", fields: [userId], references: [id])
  tenantId           String?
  tenant             Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// e.g. 2026-27
  fyLabel            String
  /// 24Q | 26Q | 27Q | 27EQ
  form               String
  /// Q1 | Q2 | Q3 | Q4
  quarter            String
  isFiled            Boolean   @default(false)
  filedDate          DateTime?
  acknowledgementNo  String?
  notes              String?
  isDeleted          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([userId, fyLabel, form, quarter])
  @@index([tenantId, fyLabel, form, quarter])
  @@index([userId, isDeleted, fyLabel])
}

/// Books mapping of a deposit challan amount to a deductee/collectee document (not TRACES).
enum TaxDepositChallanSourceType {
  PURCHASE
  INVOICE
  /// Salary TDS deductee line (Form 24Q)
  SALARY
}

model TaxDepositChallanAllocation {
  id         String                       @id @default(uuid())
  challanId  String
  challan    TaxDepositChallan            @relation(fields: [challanId], references: [id], onDelete: Cascade)
  /// PURCHASE = Form 26Q/27Q; INVOICE = Form 27EQ; SALARY = Form 24Q
  sourceType TaxDepositChallanSourceType
  sourceId   String
  amount     Decimal                      @db.Decimal(18, 4)
  userId     String
  user       User                         @relation("UserTaxDepositChallanAllocations", fields: [userId], references: [id])
  tenantId   String?
  tenant     Tenant?                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  @@unique([challanId, sourceType, sourceId])
  @@index([sourceType, sourceId])
  @@index([tenantId, sourceType, sourceId])
  @@index([userId])
}

/// Salary TDS deductee (Form 24Q books worksheet — not TRACES / full payroll).
model SalaryTdsEmployee {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation("UserSalaryTdsEmployees", fields: [userId], references: [id])
  tenantId     String?
  tenant       Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  pan          String?
  employeeCode String?
  isDeleted    Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deductions   SalaryTdsDeduction[]

  @@index([userId, isDeleted])
  @@index([tenantId, isDeleted])
}

/// Per-pay salary TDS line u/s 192 (Form 24Q annexure books).
model SalaryTdsDeduction {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation("UserSalaryTdsDeductions", fields: [userId], references: [id])
  tenantId   String?
  tenant     Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employeeId String
  employee   SalaryTdsEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Date salary credited / TDS deducted
  payDate    DateTime
  amountPaid Decimal           @db.Decimal(18, 4)
  tdsAmount  Decimal           @db.Decimal(18, 4)
  section    String            @default("192")
  notes      String?
  /// Employee share PF/ESI for §36(1)(va) books screen (not EPFO/ESIC portal).
  employeePfAmount   Decimal?  @db.Decimal(18, 4)
  employeeEsiAmount  Decimal?  @db.Decimal(18, 4)
  pfDueDate          DateTime?
  pfDepositedDate    DateTime?
  esiDueDate         DateTime?
  esiDepositedDate   DateTime?
  isDeleted  Boolean           @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId, isDeleted, payDate])
  @@index([tenantId, isDeleted, payDate])
  @@index([employeeId, isDeleted])
}

model PettyCashTransaction {
  id              String                          @id @default(uuid())
  pettyCashId     String
  pettyCash       PettyCash                       @relation("PettyCashTransactions", fields: [pettyCashId], references: [id])
  transactionDate DateTime                        @default(now())
  transactionType PettyCashTransactionType
  amount          Decimal                         @db.Decimal(18, 4)
  balanceBefore   Decimal                         @db.Decimal(18, 4)
  balanceAfter    Decimal                         @db.Decimal(18, 4)
  remarks         String?
  relatedType     PettyCashTransactionRelatedType
  relatedId       String
  isDeleted       Boolean                         @default(false)
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  @@index([pettyCashId])
  @@index([transactionDate])
  @@index([relatedType, relatedId])
  @@index([isDeleted])
}

model Purchase {
  id                String           @id @default(uuid())
  purchaseId        String?          @unique // TODO 0.1c: app-generated PUR-NNNNNN
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?   @relation("PurchaseFromOrder", fields: [purchaseOrderId], references: [id])
  vendorId          String?
  vendor            User?            @relation("PurchaseVendor", fields: [vendorId], references: [id])
  purchaseDate      DateTime         @default(now())
  dueDate           DateTime
  referenceNo       String?          @default("")
  items             Json?
  status            PurchaseStatus   @default(pending)
  paymentModeId     String?
  paymentMode       PaymentMode?     @relation("PurchasePaymentMode", fields: [paymentModeId], references: [id])
  /// GST reverse charge on inward supply.
  isReverseCharge   Boolean          @default(false)
  taxableAmount     Decimal          @db.Decimal(18, 4)
  totalDiscount     Decimal          @default(0) @db.Decimal(18, 4)
  totalTax          Decimal          @default(0) @db.Decimal(18, 4)
  roundOff          Boolean          @default(false)
  totalAmount       Decimal          @db.Decimal(18, 4)
  paidAmount        Decimal          @default(0) @db.Decimal(18, 4)
  balanceAmount     Decimal          @default(0) @db.Decimal(18, 4)
  /// Optional TDS section code (e.g. 194C) when deduction applied.
  tdsSection        String?
  tdsRatePercent    Decimal?         @db.Decimal(7, 4)
  tdsAmount         Decimal?         @default(0) @db.Decimal(18, 4)
  /// Stock receipt warehouse (defaults to Main Warehouse when unset).
  warehouseId       String?
  warehouse         Warehouse?       @relation("PurchaseWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  bankId            String?
  bank              BankDetail?      @relation("PurchaseBank", fields: [bankId], references: [id])
  notes             String?
  termsAndCondition String?
  sign_type         PurchaseSignType @default(none)
  signatureId       String?
  signature         Signature?       @relation("PurchaseSignature", fields: [signatureId], references: [id])
  signatureImage    String?
  signatureName     String?
  checkNumber       String?
  isDeleted         Boolean          @default(false)
  userId            String
  user              User             @relation("PurchaseUser", fields: [userId], references: [id])
  tenantId          String?
  tenant            Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billFrom          String
  billFromUser      User             @relation("PurchaseBillFrom", fields: [billFrom], references: [id])
  billTo            String
  billToUser        User             @relation("PurchaseBillTo", fields: [billTo], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  approvalStatus    ApprovalStatus   @default(NOT_REQUIRED)
  approvedById      String?
  approvedAt        DateTime?
  rejectionReason   String?
  currencyCode      String?
  exchangeRate      Decimal?         @db.Decimal(18, 8)
  /// Optional books FMV for §40A(2) excess tag (related-party). Not Form 3CD / AO opinion.
  section40A2FairMarketValue Decimal? @db.Decimal(18, 4)
  section40A2FmvNote         String?

  costCenterId String?
  costCenter   CostCenter? @relation("CostCenterPurchases", fields: [costCenterId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?    @relation("ProjectPurchases", fields: [projectId], references: [id], onDelete: SetNull)

  // P3.5: optional landed cost (freight/duties) to allocate into inventory unit cost.
  landedCost Decimal? @db.Decimal(18, 4)

  supplierPayments SupplierPayment[] @relation("PurchaseSupplierPayments")
  debitNotes       DebitNote[]       @relation("DebitNotePurchase")
  // Cluster H — slice H.2 (purchase created from an AI extraction job)
  aiExtractionJob  AiExtractionJob?  @relation("PurchaseFromAi")

  @@index([tenantId])
  @@index([userId, isDeleted])
}

model PurchaseOrder {
  id                String                    @id @default(uuid())
  purchaseOrderId   String?                   @unique // TODO 0.1c: app-generated PO-NNNNNN
  vendorId          String?
  vendor            User?                     @relation("PurchaseOrderVendor", fields: [vendorId], references: [id])
  purchaseOrderDate DateTime                  @default(now())
  dueDate           DateTime
  referenceNo       String?                   @default("")
  items             Json?
  status            PurchaseOrderStatus       @default(new)
  paymentMode       PurchaseOrderPaymentMode?
  taxableAmount     Decimal                   @db.Decimal(18, 4)
  totalDiscount     Decimal                   @default(0) @db.Decimal(18, 4)
  vat               Decimal                   @default(0) @db.Decimal(18, 4)
  roundOff          Boolean                   @default(false)
  TotalAmount       Decimal                   @db.Decimal(18, 4)
  bankId            String?
  bank              BankDetail?               @relation("PurchaseOrderBank", fields: [bankId], references: [id])
  notes             String?
  termsAndCondition String?
  sign_type         PurchaseOrderSignType     @default(none)
  signatureId       String?
  signature         Signature?                @relation("PurchaseOrderSignature", fields: [signatureId], references: [id])
  signatureImage    String?
  signatureName     String?
  isDeleted         Boolean                   @default(false)
  userId            String
  user              User                      @relation("PurchaseOrderUser", fields: [userId], references: [id])
  tenantId          String?
  tenant            Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billFrom          String
  billFromUser      User                      @relation("PurchaseOrderBillFrom", fields: [billFrom], references: [id])
  billTo            String
  billToUser        User                      @relation("PurchaseOrderBillTo", fields: [billTo], references: [id])
  convert_type      PurchaseOrderConvertType  @default(purchase)
  currencyCode      String? // C.1: per-document currency (ISO code, e.g. USD)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  purchases Purchase[] @relation("PurchaseFromOrder")

  @@index([tenantId])
  @@index([userId, isDeleted])
}

// =============================================================================
// Models — Config & geo (E)
// =============================================================================

model City {
  id         String   @id @default(uuid())
  name       String?
  state_id   String?
  country_id String?
  state      State?   @relation("StateCities", fields: [state_id], references: [id])
  country    Country? @relation("CountryCities", fields: [country_id], references: [id])
  users      User[]   @relation("CityUsers")

  @@index([state_id])
  @@index([country_id])
}

model State {
  id         String    @id @default(uuid())
  name       String?
  country_id String?
  state_code String?
  country    Country?  @relation("CountryStates", fields: [country_id], references: [id])
  cities     City[]    @relation("StateCities")
  users      User[]    @relation("StateUsers")
  taxRates   TaxRate[] @relation("TaxRateState")

  @@index([country_id])
}

model Country {
  id        String  @id @default(uuid())
  name      String?
  iso3      String?
  iso2      String?
  phonecode String?
  capital   String?
  currency  String?
  native    String?
  region    String?
  subregion String?

  states          State[]           @relation("CountryStates")
  cities          City[]            @relation("CountryCities")
  users           User[]            @relation("CountryUsers")
  taxRates        TaxRate[]         @relation("TaxRateCountry")
  companySettings CompanySettings[] @relation("CompanySettingsCountry")
}

model CompanySettings {
  id                   String    @id @default(uuid())
  companyName          String
  email                String
  phone                String
  address              String
  city                 String
  state                String
  country              String
  pincode              String
  siteLogo             String?   @default("")
  favicon              String?   @default("")
  companyLogo          String?   @default("")
  companyBanner        String?   @default("")
  fax                  String?
  gstin                String?
  /// Income-tax TAN (Form 26Q / 27EQ deductor / collector).
  tan                  String?
  /// Composition dealer under GST — no tax on outward invoices; blocks e-invoice IRN.
  isComposition        Boolean   @default(false)
  userId               String    @unique
  user                 User      @relation("UserCompanySettings", fields: [userId], references: [id])
  tenantId             String?   @unique
  tenant               Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxRegime            TaxRegime @default(NONE)
  countryId            String?
  countryRef           Country?  @relation("CompanySettingsCountry", fields: [countryId], references: [id])
  publicBaseUrl        String?
  merchantUpiId        String?
  merchantName         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  countryCode          String?
  functionalCurrency   String?
  fiscalYearStartMonth Int?
  goLiveDate           DateTime?
  ledgerInitialized    Boolean   @default(false)
  approvalsEnabled     Boolean   @default(false)

  reminders Reminder[] @relation("CompanySettingsReminders")
}

model Currency {
  id            String   @id @default(uuid())
  name          String
  code          String
  symbol        String
  status        Boolean? @default(true)
  isDefault     Boolean? @default(false)
  isDeleted     Boolean? @default(false)
  createdBy     String
  createdByUser User     @relation("CurrencyCreatedBy", fields: [createdBy], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DateFormat {
  id            String   @id @default(uuid())
  title         String   @unique
  format        String   @unique
  isActive      Boolean? @default(true)
  isDeleted     Boolean? @default(false)
  createdBy     String?
  createdByUser User?    @relation("DateFormatCreatedBy", fields: [createdBy], references: [id])
  updatedBy     String?
  updatedByUser User?    @relation("DateFormatUpdatedBy", fields: [updatedBy], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  localizations Localization[] @relation("LocalizationDateFormat")

  @@index([title])
  @@index([format])
}

/// SMTP/Resend/Node mail config. One workspace row per tenant (tenantId unique when set).
model EmailSettings {
  id              String                    @id @default(uuid())
  provider_type   EmailSettingsProviderType
  nodeFromName    String?
  nodeFromEmail   String?
  nodeReplyTo     String?
  nodeHost        String?
  nodePort        String?
  nodeUsername    String?
  nodePassword    String?
  smtpFromName    String?
  smtpFromEmail   String?
  smtpReplyTo     String?
  smtpHost        String?
  smtpPort        String?
  smtpUsername    String?
  smtpPassword    String?
  resendFromName  String?
  resendFromEmail String?
  resendReplyTo   String?
  resendApiKey    String?
  smtp_status     Boolean?                  @default(false)
  node_status     Boolean?                  @default(false)
  resend_status   Boolean?                  @default(false)
  userId          String                    @unique
  user            User                      @relation("UserEmailSettings", fields: [userId], references: [id])
  tenantId        String?                   @unique
  tenant          Tenant?                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
}

model GeneralSetting {
  id            String   @id @default(uuid())
  key           String
  value         Json
  groupSlug     String?  @default("general")
  tenantId      String?
  tenant        Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy     String?
  createdByUser User?    @relation("GeneralSettingCreatedBy", fields: [createdBy], references: [id])
  updatedBy     String?
  updatedByUser User?    @relation("GeneralSettingUpdatedBy", fields: [updatedBy], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, key], name: "general_setting_tenant_key_unique")
  @@index([key])
  @@index([tenantId])
  @@index([groupSlug])
}

model Localization {
  id           String                 @id @default(uuid())
  userId       String?
  user         User?                  @relation("UserLocalizations", fields: [userId], references: [id])
  tenantId     String?                @unique
  tenant       Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dateFormatId String
  dateFormat   DateFormat             @relation("LocalizationDateFormat", fields: [dateFormatId], references: [id])
  timeFormatId String
  timeFormat   TimeFormat             @relation("LocalizationTimeFormat", fields: [timeFormatId], references: [id])
  timezoneId   String
  timezone     Timezone               @relation("LocalizationTimezone", fields: [timezoneId], references: [id])
  startWeek    LocalizationStartWeek? @default(Monday)
  isActive     Boolean?               @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([userId, isActive], name: "localization_user_active_unique")
}

model PaymentMode {
  id        String   @id @default(uuid())
  name      String
  /// Globally unique. System modes use short slugs (cash, bank-transfer);
  /// custom tenant modes use `{tenantPrefix}-{slug}` to avoid collisions.
  slug      String   @unique
  status    Boolean? @default(true)
  /// System modes (cash, bank-transfer, …) are shared; custom modes are tenant-scoped.
  isSystem  Boolean  @default(false)
  userId    String?
  user      User?    @relation("UserPaymentModes", fields: [userId], references: [id])
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bankTransactions BankTransaction[] @relation("PaymentModeBankTransactions")
  supplierPayments SupplierPayment[] @relation("PaymentModeSupplierPayments")
  expenses         Expense[]         @relation("ExpensePaymentMode")
  purchases        Purchase[]        @relation("PurchasePaymentMode")
  debitNotes       DebitNote[]       @relation("PaymentModeDebitNotes")
  invoicePayments  InvoicePayment[]  @relation("PaymentModeInvoicePayments")

  @@index([tenantId])
  @@index([userId])
  @@index([isSystem])
}

model TaxGroup {
  id         String    @id @default(uuid())
  tax_name   String
  status     Boolean?  @default(true)
  userId     String?
  user       User?     @relation("UserTaxGroups", fields: [userId], references: [id])
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  created_on DateTime? @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tax_rates TaxRate[] @relation("TaxGroupTaxRates")
  products  Product[] @relation("TaxGroupProducts")

  @@index([tenantId])
  @@index([userId])
}

model TaxRate {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation("UserTaxRates", fields: [userId], references: [id])
  /// Tenant that owns this rate library row (nullable during backfill / legacy).
  tenantId  String?
  tenant    Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  regime    TaxRegime
  taxKind   TaxKind?
  name      String
  rate      Decimal   @db.Decimal(7, 4)
  countryId String?
  country   Country?  @relation("TaxRateCountry", fields: [countryId], references: [id])
  stateId   String?
  state     State?    @relation("TaxRateState", fields: [stateId], references: [id])
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tax_groups TaxGroup[] @relation("TaxGroupTaxRates")

  @@index([userId, isDeleted, regime])
  @@index([tenantId, isDeleted, regime])
}

/// India TDS section rate library (MVP — deduction amounts stored on Purchase).
model TdsRate {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserTdsRates", fields: [userId], references: [id])
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// e.g. 194C, 194J, 194I
  section    String
  name       String
  rate       Decimal  @db.Decimal(7, 4)
  threshold  Decimal? @db.Decimal(18, 4)
  isActive   Boolean  @default(true)
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, isDeleted])
  @@index([tenantId, isDeleted, section])
}

/// India TCS section rate library (MVP — collection amounts stored on Invoice).
model TcsRate {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation("UserTcsRates", fields: [userId], references: [id])
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// e.g. 206C(1H), 206C(1)
  section    String
  name       String
  rate       Decimal  @db.Decimal(7, 4)
  threshold  Decimal? @db.Decimal(18, 4)
  /// When true, compute TCS on taxable + GST (common for 206C(1H)).
  onTaxInclusive Boolean @default(true)
  isActive   Boolean  @default(true)
  isDeleted  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, isDeleted])
  @@index([tenantId, isDeleted, section])
}

/// Manual ITC reversal rows for GSTR-3B table 4(B) books worksheet (Rule 42/43 / other).
model ItcReversal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("UserItcReversals", fields: [userId], references: [id])
